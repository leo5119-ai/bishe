page {
  background-color: #f8f9fa;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  min-height: 100vh;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: #f8f9fa;
}

.header-swiper {
  width: 100%;
  height: 340rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.banner-logo {
  font-size: 80rpx;
}

.banner-text {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 2rpx;
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}

.content {
  padding: 30rpx 40rpx;
  margin-top: 20rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.notice-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #ff9800;
}

.notice-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.notice-icon {
  font-size: 32rpx;
}

.notice-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff9800;
}

.notice-content {
  font-size: 26rpx;
  color: #555;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stats-card {
  padding: 36rpx 32rpx;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.stat-main {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.stat-value {
  font-size: 72rpx;
  font-weight: 700;
  color: #1a73e8;
  line-height: 1;
}

.stat-unit {
  font-size: 32rpx;
  color: #1a73e8;
  font-weight: 500;
}

.stat-info {
  flex: 1;
}

.stat-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.stat-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.dot {
  color: #ddd;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 24rpx;
}

.floor-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.floor-item {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.floor-item::before {
  content: '';
  position: absolute;
  right: -30rpx;
  top: -30rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
}

.floor-1 {
  background: linear-gradient(135deg, #00c853 0%, #00a844 100%);
}

.floor-2 {
  background: linear-gradient(135deg, #2979ff 0%, #1565c0 100%);
}

.floor-3 {
  background: linear-gradient(135deg, #ff9100 0%, #ff6d00 100%);
}

.floor-icon {
  font-size: 56rpx;
  margin-right: 28rpx;
}

.floor-text {
  display: flex;
  flex-direction: column;
}

.floor-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
}

.floor-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}