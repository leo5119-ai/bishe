page {
  background-color: #F8F5F0;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.floor-header {
  background: linear-gradient(135deg, #1565C0, #1976D2);
  padding: 24rpx 30rpx;
  flex-shrink: 0;
}

.floor-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.floor-tip {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 4rpx;
}

.floor-scroll {
  flex: 1;
  background: #F8F5F0;
  padding: 20rpx;
}

.floor-map {
  position: relative;
  width: 400px;
  height: 320px;
}

.wall-frame {
  position: absolute;
  left: 0;
  top: 0;
  width: 400px;
  height: 320px;
  border: 4px solid #D4C4B0;
  border-radius: 8px;
  background: #F8F5F0;
  position: relative;
}

.entrance {
  position: absolute;
  top: -4px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

.entrance-text {
  font-size: 20rpx;
  color: #1976D2;
  font-weight: 500;
}

.entrance-arrow {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 16rpx solid #90CAF9;
}

.facility {
  position: absolute;
  background: #B0BEC5;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.facility text {
  font-size: 18rpx;
  color: #546E7A;
}

.restroom {
  right: 15px;
  bottom: 15px;
  width: 60px;
  height: 40px;
}

.stairs {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 25px;
  height: 45px;
  background: #CFD8DC;
  border-radius: 6rpx 0 0 6rpx;
}

.table {
  position: absolute;
  background: #E6C9A0;
  border: 2px solid #8B7355;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.table.bookshelf {
  background: #A1887F;
  border-color: #6D4C41;
}

.table-label {
  font-size: 22rpx;
  color: #5D4037;
  font-weight: 500;
}

.table.bookshelf .table-label {
  color: #EFEBE9;
}

.seat {
  position: absolute;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #4ADE80;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  transition: transform 0.15s, box-shadow 0.15s;
}

.seat:active {
  transform: scale(0.92);
}

.seat-id {
  font-size: 16rpx;
  color: #fff;
  font-weight: 600;
}

.seat.occupied {
  background: #F87171;
}

.seat.mine {
  background: #60A5FA;
}

.seat.maintenance {
  background: #9CA3AF;
}

.seat.selected {
  box-shadow: 0 0 0 4px rgba(255,255,255,0.8), 0 4rpx 16rpx rgba(0,0,0,0.25);
  transform: scale(1.1);
}

.legend-bar {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #EEE;
  flex-shrink: 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}

.legend-dot.available {
  background: #4ADE80;
}

.legend-dot.occupied {
  background: #F87171;
}

.legend-dot.mine {
  background: #60A5FA;
}

.legend-dot.maintenance {
  background: #9CA3AF;
}

.legend-item text {
  font-size: 24rpx;
  color: #666;
}

.action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #EEE;
  flex-shrink: 0;
}

.action-info {
  flex: 1;
}

.action-seat {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
