page {
  background-color: #f8f9fa;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  padding-bottom: 180rpx;
}

.container {
  padding: 30rpx;
}

.seat-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  width: 690rpx;
}

.seat-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}

.seat-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.seat-no {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.seat-floor {
  font-size: 26rpx;
  color: #888;
}

.seat-tags {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  width: 690rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.date-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #e3f2fd;
  color: #1976d2;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.time-tip {
  font-size: 24rpx;
  color: #ff9800;
  margin-bottom: 24rpx;
}

.time-selector {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.time-label {
  width: 200rpx;
  font-size: 28rpx;
  color: #333;
}

.hint {
  font-size: 22rpx;
  color: #888;
}

.time-picker-btn {
  flex: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-picker-btn text {
  font-size: 28rpx;
  color: #333;
}

.time-picker-btn .arrow {
  font-size: 36rpx;
  color: #ccc;
}

.time-info {
  background: #e3f2fd;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1976d2;
}

.duration-hint {
  color: #e53935;
  margin-left: 20rpx;
}

.conflict-tip {
  background: #ffebee;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #e53935;
  margin-top: 20rpx;
}

.time-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.time-card {
  position: relative;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
}

.time-card.selected {
  background: #1976d2;
  border-color: #1976d2;
}

.time-card.selected .time-range,
.time-card.selected .time-dur {
  color: #fff;
}

.time-range {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.time-dur {
  font-size: 22rpx;
  color: #888;
}

.time-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: #fff;
  color: #1976d2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
}

.confirm-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
}

.confirm-info {
  display: flex;
  flex-direction: column;
}

.confirm-time {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.confirm-dur {
  font-size: 22rpx;
  color: #888;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}

.picker-header .cancel,
.picker-header .confirm {
  color: #576b95;
}