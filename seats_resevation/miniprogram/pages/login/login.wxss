page {
  height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.bg-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 55vh;
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
}

.content {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 50rpx;
}

.logo-section {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  font-size: 140rpx;
  margin-bottom: 30rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.login-box {
  flex: 1;
  margin-top: 80rpx;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 60rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.1);
}

.welcome-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.welcome-text text:first-child {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.welcome-text text:last-child {
  font-size: 26rpx;
  color: #888;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1a73e8, #1565c0);
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 30rpx rgba(26,115,232,0.35);
}

.login-btn::after {
  border: none;
}

.btn-icon {
  font-size: 40rpx;
}

.agreement {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

.link {
  color: #1a73e8;
}

.footer {
  padding: 30rpx;
  text-align: center;
}

.footer text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}