<view class="container">
  <view class="bg-gradient"></view>
  
  <view class="content">
    <view class="logo-section">
      <view class="logo-icon">📚</view>
      <text class="app-name">图书馆座位预约</text>
      <text class="app-slogan">便捷预约 · 畅享阅读</text>
    </view>

    <view class="login-box">
      <view class="welcome-text">
        <text>欢迎使用</text>
        <text>请先登录后再使用预约功能</text>
      </view>

      <button 
        class="login-btn" 
        type="primary" 
        round 
        loading="{{loading}}"
        bindtap="handleLogin"
      >
        <text class="btn-icon">👤</text>
        <text>微信一键登录</text>
      </button>

      <view class="agreement">
        <text>登录即表示同意</text>
        <text class="link">《用户协议》</text>
        <text>和</text>
        <text class="link">《隐私政策》</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text>图书馆管理系统 v1.0</text>
  </view>
</view>