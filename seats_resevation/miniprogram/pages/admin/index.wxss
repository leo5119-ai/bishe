page {
  background-color: #F5F5F5;
  min-height: 100vh;
}

.container {
  min-height: 100vh;
}

.tab-content {
  padding: 20rpx;
  box-sizing: border-box;
  width: 100%;
}

.floor-selector {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.selector-label {
  font-size: 28rpx;
  color: #333333;
  margin-right: 16rpx;
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.seat-info {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.seat-item {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-height: 160rpx;
  justify-content: center;
}

.seat-item.available {
  border: 2rpx solid #E8F5E9;
}

.seat-item.occupied {
  border: 2rpx solid #FFEBEE;
}

.seat-item.maintenance {
  border: 2rpx solid #FFF3E0;
  background-color: #FFF8E1;
}

.seat-toggle {
  margin-top: 8rpx;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #666;
}

.floor-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.floor-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.floor-tab.active {
  color: #1989fa;
  border-bottom-color: #1989fa;
}

.seat-no, .seat-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.reservation-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.reservation-item {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.res-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.res-seat {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.res-time {
  font-size: 24rpx;
  color: #999999;
}

.stats-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 8rpx;
}

.stats-value.success {
  color: #4CAF50;
}

.stats-value.warning {
  color: #FF9800;
}

.stats-label {
  font-size: 22rpx;
  color: #999999;
}

.usage-rate {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
  font-size: 28rpx;
  color: #333333;
}

.announcement-section {
  margin-top: 20rpx;
}

.editor-popup {
  padding: 30rpx;
}

.editor-header {
  margin-bottom: 30rpx;
}

.editor-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.editor-popup van-field {
  margin-bottom: 20rpx;
}

.announcement-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.announcement-textarea {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  min-height: 150rpx;
  margin-bottom: 20rpx;
}

.editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
  color: #999999;
  font-size: 28rpx;
}

.init-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}

.init-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.init-tip {
  font-size: 22rpx;
  color: #999999;
  margin-top: 16rpx;
}

.qrcode-section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}

.qrcode-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.qrcode-img {
  width: 300rpx;
  height: 300rpx;
}

.qrcode-tip {
  font-size: 24rpx;
  color: #666666;
  margin-top: 16rpx;
}

.user-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.user-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 200rpx;
}

.user-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.user-credit {
  font-size: 24rpx;
  color: #666;
}

.user-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.credit-editor {
  padding: 30rpx 0;
}

.credit-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  text-align: center;
}

.credit-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
  text-align: center;
}